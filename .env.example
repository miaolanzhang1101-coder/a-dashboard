# PostgreSQL connection string (Supabase, Neon, Railway, local, etc.)
# Supabase: use the "Transaction" pooler URI on port 6543 for serverless deploys.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autumn"

# Optional: set to let "Ask Autumn" answer with the Anthropic API instead of the
# built-in data responder. Without it, Ask Autumn still works from your live data.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"
